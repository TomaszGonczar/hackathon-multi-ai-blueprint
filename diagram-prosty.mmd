flowchart LR

    TEMAT["<b>🎯 TEMAT</b><br/>ogłoszony o godz. 0"]:::start

    subgraph S1["🔬 SYSTEM 1 — research + brainstorm · 1 laptop · ~2 h · OMP"]
        direction TB
        R["<b>Research</b> — 6–10 sesji równolegle<br/><i>każda = jedno pytanie → swój plik</i>"]:::s1
        B["<b>Brainstorm</b> — 3 sesje, 3 wejścia<br/><i>pragmatyk · sceptyk · outsider</i>"]:::s1
        V{{"<b>👥 ZESPÓŁ WYBIERA</b><br/>na głos · system 1 nie wybiera"}}:::human
        R --> B --> V
    end

    KAPS{{"<b>📦 KAPSULA.md</b> — jedyny przewód<br/>co budujemy · dlaczego · co wiemy (z linkami)<br/>czego nie wiemy · 5 kawałków · jak sprawdzamy"}}:::capsule

    subgraph S2["🚧 SYSTEM 2 — budowa · 5 osób × 5 worktree · OMP · do wysłania"]
        direction TB
        W["Każdy czyta kapsułę<br/>i robi SWÓJ katalog"]:::s2
        C["<b>check.sh</b> — jedna komenda<br/><i>exit 0 = gotowe · bez niego nie startujemy</i>"]:::gate
        RV["<b>Review</b> — świeża sesja<br/>widzi TYLKO diff + kapsułę<br/><i>1–2 agenty · tnijemy pierwsze</i>"]:::opt
        W --> C --> RV
    end
    KAPS{{"<b>📦 KAPSULA.md</b><br/>co · dlaczego · co wiemy · czego nie wiemy<br/>5 kawałków · jedna komenda"}}:::capsule
    MERGE{{"<b>✋ MERGE</b><br/>człowiek, imiennie<br/><i>+ wariant awaryjny z piątku</i>"}}:::human
    MAIN[("<b>main</b> — to idzie na hackathon")]

    TEMAT --> R
    V -->|"wpisuje wybór<br/>i milczy"| KAPS
    KAPS -->|"czytają jako pierwsze<br/>i nie wracają po radę"| W
    RV --> MERGE
    MERGE --> MAIN

