}}%%
flowchart LR

    TEMAT["<b>🎯 TEMAT</b><br/>ogłoszony o godz. 0"]:::start

    subgraph S1["🔬 SYSTEM 1 — 60 minut · 1 laptop · OMP"]
        direction TB
        R["<b>Research 35 min</b> — 5 sesji równolegle<br/><i>jedno pytanie → swój plik</i>"]:::s1
        B["<b>Brainstorm 13 min</b> — 3 sesje<br/><i>pragmatyk · sceptyk · outsider</i>"]:::s1
        V{{"<b>👥 ZESPÓŁ WYBIERA</b><br/>na głos · system 1 nie wybiera"}}:::human
        R --> B --> V
    end

    KAPS{{"<b>📦 KAPSULA.md</b><br/>co · dlaczego · co wiemy · czego nie wiemy<br/>5 kawałków + kolejność · jedna komenda"}}:::capsule

    subgraph S2["🤖 SYSTEM 2 — non-stop · 5 osób × 5 worktree · OMP"]
        direction TB
        W["Każdy czyta kapsułę<br/>i robi SWÓJ katalog"]:::s2
        C["<b>check.sh</b> — jedna komenda<br/><i>exit 0 = gotowe</i>"]:::gate
        RV["<b>Review</b> — świeża sesja<br/>widzi TYLKO diff + kapsułę"]:::opt
        M{{"<b>⚙️ MERGE — maszyna</b><br/>wpuszcza na main sama<br/>czeka na zależności · rozwiązuje konflikty mechaniczne<br/><i>interfejs → STOP do człowieka</i>"}}:::machine
        W --> C --> RV --> M
    end

    WAIT["⏳ czeka na inne moduły<br/><i>nie pyta · nie blokuje · wraca do pracy</i>"]:::wait
    MAIN[("<b>main</b>")]

    SYNC{{"<b>✋ CZŁOWIEK — 2×</b><br/>sync co 2 h · freeze 4 h przed deadlinem<br/><i>maszyna może wjechać wszystko.<br/>nie może powiedzieć, co wysyłacie.</i>"}}:::human

    TEMAT --> R
    V -->|"wpisuje wybór<br/>i milczy"| KAPS
    KAPS -->|"czytają jako pierwsze<br/>i nie wracają po radę"| W
    M --> MAIN
    M -.->|"nie wjeżdża, bo zależność<br/>jeszcze nie na main"| WAIT
    WAIT -.->|"spróbuje ponownie<br/>za 10 minut"| M
    MAIN --> SYNC

