%%{init: {
  "theme": "base",
  "flowchart": { "htmlLabels": true, "padding": 12, "curve": "basis", "nodeSpacing": 34, "rankSpacing": 60 },
  "themeVariables": {
    "fontSize": "15px",
    "primaryColor": "#eef2ff",
    "primaryBorderColor": "#4f46e5",
    "primaryTextColor": "#1e1b4b",
