    classDef capsule fill:#e0f2fe,stroke:#0369a1,stroke-width:3px
    classDef gate fill:#dcfce7,stroke:#15803d,stroke-width:2px
    classDef machine fill:#ede9fe,stroke:#6d28d9,stroke-width:2.5px
    classDef wait fill:#fff7ed,stroke:#c2410c,stroke-width:1.5px,stroke-dasharray:5 3
